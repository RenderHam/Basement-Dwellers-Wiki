---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/Card.astro";
import CopyField from "../components/ui/CopyField.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FaqCategory from "../components/faq/FaqCategory.astro";
import { FAQ_CATEGORIES } from "../data/faq";
import { SITE } from "../data/site";

const totalAnswers = FAQ_CATEGORIES.reduce((sum, category) => sum + category.items.length, 0);
---

<Layout
  title="FAQ"
  description="Answers about joining Basement Dwellers: the modpack and required mods, Java vs Bedrock, rules and griefing policy, the live BlueMap, whitelisting and backups."
>
  <Header />
  <main>
    <section class="strata-hero border-b border-line">
      <div class="mx-auto w-full max-w-6xl px-4 pb-16 pt-20 sm:px-6 sm:pt-24">
        <p class="eyebrow">Before you ask</p>
        <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold tracking-tight text-bone sm:text-5xl">
          Questions, answered.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          The common stuff — getting in, staying in, and how the basement works. Still stuck
          afterwards? The Discord is one click away.
        </p>
        <p
          aria-hidden="true"
          class="mt-6 font-mono text-xs uppercase tracking-[0.25em] text-muted"
        >
          {totalAnswers} answers · {FAQ_CATEGORIES.length} topics · 1 basement
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            href={SITE.discordUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-line px-5 py-2.5 text-sm font-medium text-bone transition-all duration-200 hover:border-accent hover:text-accent"
          >
            Ask on Discord
            <svg
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7"></path>
              <path d="M8 7h9v9"></path>
            </svg>
          </a>
          <a href="/tutorial" class="text-sm font-medium text-muted transition-colors hover:text-accent">
            New here? Read the tutorial first →
          </a>
        </div>
      </div>
    </section>

    <div class="mx-auto w-full max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="space-y-16 sm:space-y-20">
        {FAQ_CATEGORIES.map((category) => <FaqCategory category={category} />)}
      </div>

      <section aria-label="Quick help" class="mt-16 border-t border-line pt-12 sm:mt-20">
        <SectionHeading
          eyebrow="Quick help"
          title="Still digging?"
          description="The two things people ask for most, kept within reach."
        />
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <Card hover class="flex flex-col gap-4">
            <CopyField value={SITE.serverIp} label="Server address" />
            <p class="text-sm leading-relaxed text-muted">
              Multiplayer → Direct Connect → paste. First time connecting? The Tutorial page walks
              you through it.
            </p>
          </Card>
          <Card hover class="flex flex-col gap-2">
            <p class="eyebrow">Live map</p>
            <a
              href={SITE.blueMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 font-display text-xl font-bold tracking-tight text-bone transition-colors duration-200 hover:text-accent"
            >
              Open the BlueMap
              <svg
                class="size-4 text-muted transition-all duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7"></path>
                <path d="M8 7h9v9"></path>
              </svg>
            </a>
            <p class="mt-auto pt-2 text-sm leading-relaxed text-muted">
              The whole world, rendered live in your browser — scout build spots, admire rooftops,
              find your way home.
            </p>
          </Card>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
