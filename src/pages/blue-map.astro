---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/Card.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { SITE } from "../data/site";
---

<Layout title="Blue Map">
  <Header />
  <main>
    <section class="strata-hero border-b border-line">
      <div class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="eyebrow">Live map</p>
        <h1
          class="mt-4 max-w-3xl font-display text-4xl font-bold tracking-tight text-bone sm:text-5xl"
        >
          See the whole underworld — live.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          BlueMap renders our world straight into your browser as it grows. Scout base locations,
          follow roads across the surface, and watch new tunnels appear in real time.
        </p>
      </div>
    </section>

    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <section class="py-10 sm:py-14" aria-label="Live map">
        <div
          class="overflow-hidden rounded-xl border border-line bg-surface shadow-[inset_0_1px_0_rgba(237,228,214,0.05)]"
        >
          <div class="relative aspect-[16/10] w-full sm:aspect-video">
            <iframe
              src={SITE.blueMapUrl}
              title="Basement Dwellers Blue Map"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
              class="absolute inset-0 h-full w-full border-0"
            ></iframe>
          </div>
          <div class="flex items-center justify-between border-t border-line/60 px-5 py-3 sm:px-6">
            <p class="font-mono text-xs break-all text-muted">{SITE.blueMapUrl}</p>
            <a
              href={SITE.blueMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex shrink-0 items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium text-accent transition-colors hover:bg-raised"
            >
              Open in new tab
              <svg
                class="size-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>

      <section class="border-t border-line py-16 sm:py-20" aria-labelledby="how-to-heading">
        <SectionHeading
          eyebrow="How to use it"
          title="Three steps to cartographer"
          description="Everything runs in the browser — here's all the orientation you need."
        />
        <ol class="mt-10 grid gap-4 sm:grid-cols-3">
          {
            [
              {
                title: "Open the link",
                description:
                  "Head to the map URL from any device with a browser — desktop, tablet, or phone. Nothing to install.",
              },
              {
                title: "Navigate & zoom",
                description:
                  "Drag to pan, scroll or pinch to zoom, and click markers for details. Fly from spawn to the far reaches in seconds.",
              },
              {
                title: "Toggle the layers",
                description:
                  "Switch between surface and cave views, reveal what's under your feet, and turn player markers on or off.",
              },
            ].map((step, index) => (
              <li>
                <Card hover class="flex h-full flex-col gap-3">
                  <span class="font-mono text-sm font-medium text-accent">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3 class="font-display text-lg font-bold tracking-tight text-bone">
                    {step.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-muted">{step.description}</p>
                </Card>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="border-t border-line pt-16 pb-20 sm:pt-20 sm:pb-24" aria-labelledby="self-host-heading">
        <div
          class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between md:gap-10"
        >
          <div class="max-w-xl">
            <h2 id="self-host-heading" class="font-display text-2xl font-bold tracking-tight text-bone">
              No setup on your end
            </h2>
            <p class="mt-3 leading-relaxed text-muted">
              You don't need to run or download anything — the map streams straight from the server,
              so any device with a browser is already good to go.
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap items-center gap-3">
            <a
              href={SITE.blueMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="from-accent to-copper text-bg inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg bg-linear-to-b px-7 py-3 text-base font-medium shadow-sm transition-all duration-200 hover:brightness-110 active:brightness-95"
            >
              Launch BlueMap fullscreen
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
