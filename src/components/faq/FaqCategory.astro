---
import type { FaqCategoryData, FaqIcon } from "../../data/faq";
import Accordion from "../ui/Accordion.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const ICON_PATHS: Record<FaqIcon, string[]> = {
  compass: [
    "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
    "m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12Z",
  ],
  wrench: [
    "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z",
  ],
  shield: [
    "M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z",
  ],
  server: ["M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z", "M4 14h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2Z", "M6 6h.01", "M6 18h.01"],
};

interface Props {
  category: FaqCategoryData;
}

const { category } = Astro.props;

const items = category.items.map((item) => ({ question: item.q, answer: item.a }));
const countLabel = `${items.length} ${items.length === 1 ? "answer" : "answers"}`;
---

<section id={category.id} aria-label={category.category} class="scroll-mt-24">
  <div class="flex items-center gap-4">
    <span
      aria-hidden="true"
      class="grid size-11 shrink-0 place-items-center rounded-lg border border-line bg-surface text-accent"
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {ICON_PATHS[category.icon].map((d) => <path d={d} />)}
      </svg>
    </span>
    <SectionHeading eyebrow={countLabel} title={category.category} />
  </div>
  <Accordion class="mt-6" items={items} />
</section>
