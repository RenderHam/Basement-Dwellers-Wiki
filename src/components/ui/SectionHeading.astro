---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, description, align = "left", class: className } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center", className]}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="font-display text-3xl font-bold tracking-tight text-bone sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 leading-relaxed text-muted">{description}</p>}
</div>
