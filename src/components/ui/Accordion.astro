---
export interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  items?: AccordionItem[];
  class?: string;
}

const { items = [], class: className } = Astro.props;
---

<div
  class:list={[
    "divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface",
    className,
  ]}
>
  {
    items.map((item) => (
      <details class="group open:border-accent/70 border-l-2 border-transparent transition-colors duration-200">
        <summary class="[&::-webkit-details-marker]:hidden hover:bg-raised flex cursor-pointer list-none select-none items-center justify-between gap-4 px-5 py-4 text-left text-sm font-medium text-bone transition-colors duration-200">
          <span>{item.question}</span>
          <svg
            class="group-open:text-accent group-open:rotate-180 size-4 shrink-0 text-muted transition-transform duration-200"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m4 6 4 4 4-4" />
          </svg>
        </summary>
        <div class="text-muted border-t border-line/60 px-5 py-4 text-sm leading-relaxed">
          {item.answer}
        </div>
      </details>
    ))
  }
</div>
