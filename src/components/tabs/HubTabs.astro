---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import {
  HUB_RESOURCES,
  HUB_RULES,
  HUB_STEPS,
  type HubResourceId,
} from "../../data/tabs-hub";

const TABS = [
  { id: "getting-started", label: "Getting Started" },
  { id: "rules", label: "Rules & Guidelines" },
  { id: "resources", label: "Resources" },
] as const;

const RESOURCE_ICONS: Record<HubResourceId, string> = {
  map: '<path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6z"/><path d="M9 4v14"/><path d="m15 6v14"/>',
  chat:
    '<path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5c-1.2 0-2.4-.3-3.4-.8L4 19.5l1.3-5.1A7.5 7.5 0 1 1 20 11.5z"/>',
  cube:
    '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12 4 7.5"/><path d="m12 12 8-4.5"/><path d="M12 12v9"/>',
  play: '<circle cx="12" cy="12" r="9"/><path d="m10 9 5 3-5 3z"/>',
};

const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="hub-tabs">
  <div class="-mx-4 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0">
    <div class="flex w-max min-w-full items-center gap-2 sm:gap-2.5">
      {
        TABS.map((tab, i) => (
          <span class="tab-item">
            <input
              type="radio"
              name="hub-tabs"
              id={`hub-tab-${tab.id}`}
              class="sr-only"
              checked={i === 0}
            />
            <label for={`hub-tab-${tab.id}`} class="tab-label">
              {tab.label}
            </label>
          </span>
        ))
      }
    </div>
  </div>

  <div class="tab-panel" data-panel="getting-started">
    <div class="grid gap-4 sm:grid-cols-3">
      {
        HUB_STEPS.map((step, i) => (
          <div class="rounded-xl border border-line bg-surface p-6 shadow-[inset_0_1px_0_rgba(237,228,214,0.05)]">
            <p class="font-mono text-xs font-medium tracking-widest text-accent">{pad(i + 1)}</p>
            <h3 class="mt-3 font-display text-lg font-semibold text-bone">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-8">
      <Button href="/tutorial">Open the full tutorial</Button>
    </div>
  </div>

  <div class="tab-panel" data-panel="rules">
    <dl class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface shadow-[inset_0_1px_0_rgba(237,228,214,0.05)]">
      {
        HUB_RULES.map((rule, i) => (
          <div class="flex flex-col gap-1.5 px-5 py-4 sm:flex-row sm:items-baseline sm:gap-6 sm:px-6">
            <dt class="shrink-0 font-medium text-bone sm:w-72">
              <span class="mr-2 font-mono text-xs font-medium text-accent">{pad(i + 1)}</span>
              {rule.title}
            </dt>
            <dd class="text-sm leading-relaxed text-muted">{rule.detail}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 text-sm text-muted">
      Full details and edge cases live on the
      <a
        href="/about"
        class="font-medium text-accent underline decoration-accent/50 underline-offset-4 transition-colors hover:decoration-accent"
      >
        About page
      </a>.
    </p>
  </div>

  <div class="tab-panel" data-panel="resources">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        HUB_RESOURCES.map((resource) => (
          <Card class="relative" hover>
            <a
              href={resource.href}
              class="group flex h-full flex-col gap-4 after:absolute after:inset-0 after:rounded-xl after:content-['']"
              target={resource.external ? "_blank" : undefined}
              rel={resource.external ? "noopener noreferrer" : undefined}
            >
              <span class="flex size-11 items-center justify-center rounded-lg border border-line bg-raised text-accent">
                <svg
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <Fragment set:html={RESOURCE_ICONS[resource.icon]} />
                </svg>
              </span>
              <span class="min-w-0">
                <span class="flex items-center gap-1.5 font-display text-base font-semibold text-bone transition-colors duration-200 group-hover:text-accent">
                  {resource.title}
                  {resource.external && (
                    <svg
                      class="size-3.5 shrink-0 text-muted transition-colors duration-200 group-hover:text-accent"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7" />
                      <path d="M8 7h9v9" />
                    </svg>
                  )}
                </span>
                <span class="mt-1.5 block text-sm leading-relaxed text-muted">
                  {resource.description}
                </span>
              </span>
            </a>
          </Card>
        ))
      }
    </div>
  </div>
</div>

<style>
  .tab-label {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.625rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition:
      color 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .tab-label:hover {
    color: var(--color-bone);
    background-color: color-mix(in oklab, var(--color-raised) 60%, transparent);
  }

  .tab-item:has(:checked) .tab-label {
    color: var(--color-accent);
    border-color: var(--color-line);
    background-color: var(--color-raised);
    box-shadow: inset 0 -2px 0 0 var(--color-accent);
  }

  .tab-item:has(:focus-visible) .tab-label {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .tab-panel {
    display: none;
    margin-top: 2rem;
  }

  .hub-tabs:has(#hub-tab-getting-started:checked) [data-panel="getting-started"],
  .hub-tabs:has(#hub-tab-rules:checked) [data-panel="rules"],
  .hub-tabs:has(#hub-tab-resources:checked) [data-panel="resources"] {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tab-panel {
      animation: hub-panel-in 150ms ease-out both;
    }
  }

  @keyframes hub-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
