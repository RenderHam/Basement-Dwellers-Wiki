---
type Token =
  | { kind: "text"; value: string }
  | { kind: "strong"; value: string }
  | { kind: "code"; value: string }
  | { kind: "link"; text: string; href: string };

const TOKEN_PATTERN = /\*\*([^*]+?)\*\*|\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)|`([^`]+)`/g;

function tokenize(source: string): Token[] {
  const tokens: Token[] = [];
  let cursor = 0;
  for (const match of source.matchAll(TOKEN_PATTERN)) {
    const start = match.index ?? 0;
    if (start > cursor) {
      tokens.push({ kind: "text", value: source.slice(cursor, start) });
    }
    if (match[1] !== undefined) {
      tokens.push({ kind: "strong", value: match[1] });
    } else if (match[2] !== undefined && match[3] !== undefined) {
      tokens.push({ kind: "link", text: match[2], href: match[3] });
    } else if (match[4] !== undefined) {
      tokens.push({ kind: "code", value: match[4] });
    }
    cursor = start + match[0].length;
  }
  if (cursor < source.length) {
    tokens.push({ kind: "text", value: source.slice(cursor) });
  }
  return tokens;
}

interface Props {
  text: string;
}

const { text } = Astro.props;
const tokens = tokenize(text);
---

{
  tokens.map((token) =>
    token.kind === "strong" ? (
      <strong class="font-semibold text-bone">{token.value}</strong>
    ) : token.kind === "code" ? (
      <code class="rounded border border-line bg-raised px-1 py-0.5 font-mono text-[0.85em] text-bone">
        {token.value}
      </code>
    ) : token.kind === "link" ? (
      <a
        href={token.href}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline decoration-accent/40 underline-offset-2 transition-colors hover:decoration-accent"
      >
        {token.text}
      </a>
    ) : (
      <Fragment>{token.value}</Fragment>
    ),
  )
}
