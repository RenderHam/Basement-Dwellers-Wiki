---
import type { InstallPath } from "../../data/tutorial";
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import ActionList from "./ActionList.astro";
import ModList from "./ModList.astro";
import RichText from "./RichText.astro";

interface Props {
  path: InstallPath;
}

const { path } = Astro.props;
---

<Card hover class="flex h-full flex-col gap-4">
  <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
    <h3 class="font-display text-lg font-bold tracking-tight text-bone">{path.title}</h3>
    <Badge variant={path.badgeVariant}>{path.badgeLabel}</Badge>
  </div>

  {
    path.intro.map((paragraph) => (
      <p class="text-sm leading-relaxed text-muted">
        <RichText text={paragraph} />
      </p>
    ))
  }

  <div class="my-1">
    <ActionList items={path.actions} />
  </div>

  {path.outro && (
    <div class="flex items-start gap-2.5 rounded-lg border border-moss/30 bg-moss/5 px-4 py-3 text-sm leading-relaxed text-moss">
      <svg
        class="mt-0.5 size-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m4 12 5 5L20 7" />
      </svg>
      <span>{path.outro}</span>
    </div>
  )}

  {
    path.mods && (
      <div class="mt-auto border-t border-line/70 pt-4">
        <p class="eyebrow mb-2">Full mod list · exact links</p>
        <ModList mods={path.mods} />
      </div>
    )
  }
</Card>
