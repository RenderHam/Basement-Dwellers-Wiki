---
import { SITE } from "../../data/site";
import type { StepBlock } from "../../data/tutorial";
import CopyField from "../ui/CopyField.astro";
import ActionList from "./ActionList.astro";
import PathCard from "./PathCard.astro";
import RichText from "./RichText.astro";

interface Props {
  blocks: StepBlock[];
}

const { blocks } = Astro.props;
---

<div class="space-y-6">
  {
    blocks.map((block) => {
      if (block.kind === "text") {
        return (
          <p class="text-base leading-relaxed text-muted">
            <RichText text={block.body} />
          </p>
        );
      }
      if (block.kind === "actions") {
        return <ActionList items={block.items} />;
      }
      if (block.kind === "paths") {
        return (
          <div class="grid gap-5 md:grid-cols-2 md:gap-6">
            {block.paths.map((path) => (
              <PathCard path={path} />
            ))}
          </div>
        );
      }
      return (
        <div class="space-y-3 rounded-xl border border-line/60 bg-raised/50 p-5">
          <CopyField value={SITE.serverIp} label="Server address" />
          <p class="text-sm leading-relaxed text-muted">{block.helper}</p>
        </div>
      );
    })
  }
</div>
