---
import type { ModEntry } from "../../data/tutorial";
import HostBadge from "./HostBadge.astro";

interface Props {
  mod: ModEntry;
  subtle?: boolean;
}

const { mod, subtle = false } = Astro.props;
---

<a
  href={mod.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "group flex items-center justify-between gap-3 rounded-lg transition-colors duration-200 hover:bg-raised",
    subtle ? "py-1.5 pl-1 pr-2" : "border border-transparent px-3 py-2 hover:border-line",
  ]}
>
  <span class="flex min-w-0 items-center gap-2">
    {subtle && <span aria-hidden="true" class="shrink-0 text-xs text-muted">↳</span>}
    <span
      class:list={[
        "truncate transition-colors duration-200 group-hover:text-accent",
        subtle ? "text-[13px] text-muted" : "text-sm text-bone",
      ]}
    >
      {mod.name}
    </span>
  </span>
  <HostBadge host={mod.host} />
</a>
