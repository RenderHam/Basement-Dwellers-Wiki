---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import type { ServerFeature, FeatureIcon } from "../../data/features";

import biomesImg from "../../assets/features/biomes.webp";
import structuresImg from "../../assets/features/structures.webp";
import endStructuresImg from "../../assets/features/end-structures.webp";
import jobsImg from "../../assets/features/jobs.webp";
import aircraftImg from "../../assets/features/aircraft.webp";
import tradeCyclingImg from "../../assets/features/trade-cycling.webp";
import skinsImg from "../../assets/features/skins.webp";

interface Props {
  feature: ServerFeature;
  index: number;
}

const { feature, index } = Astro.props;

const imageMap: Record<string, ImageMetadata> = {
  biomes: biomesImg,
  structures: structuresImg,
  "end-structures": endStructuresImg,
  jobs: jobsImg,
  aircraft: aircraftImg,
  "trade-cycling": tradeCyclingImg,
  skins: skinsImg,
};

const featureImage = imageMap[feature.id];

const iconMap: Record<FeatureIcon, string> = {
  biomes:
    '<path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 2c1 2 2 4.5 1 8-1 3.5-4 6-9 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  structures:
    '<path d="M2 20h20"/><path d="M5 20V8l7-5 7 5v12"/><path d="M9 20v-4h6v4"/><path d="M10 12h4"/>',
  end: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  jobs:
    '<path d="m14 13-7.5 7.5c-.83.83-2.17.83-3 0a2.12 2.12 0 0 1 0-3L11 10"/><path d="m16 16 6-6"/><path d="m8 8 6-6"/><path d="m9 7 8 8"/><path d="m21 11-8-8"/>',
  aircraft:
    '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  trade:
    '<path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/>',
  skins: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
};

const isEven = index % 2 === 0;
---

<article
  class:list={[
    "grid items-center gap-8 py-16 sm:gap-12 sm:py-24 md:grid-cols-2",
    isEven ? "md:grid-cols-[1fr_1.2fr]" : "md:grid-cols-[1.2fr_1fr]",
  ]}
>
  <div class:list={["min-w-0", !isEven && "md:order-2"]}>
    <div class="overflow-hidden rounded-xl border border-line bg-raised">
      {featureImage ? (
        <Image
          src={featureImage}
          alt={feature.imageAlt}
          widths={[400, 640, 800]}
          sizes="(min-width:768px) 50vw, 100vw"
          loading="lazy"
          class="aspect-[3/2] w-full object-cover"
        />
      ) : (
        <div class="flex aspect-[3/2] w-full items-center justify-center gap-3 bg-raised p-6 text-center">
          <svg class="size-8 text-muted/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="9" cy="9" r="2" />
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
          </svg>
          <span class="font-mono text-xs uppercase tracking-widest text-muted/50">Screenshot coming soon</span>
        </div>
      )}
    </div>
  </div>

  <div class:list={["min-w-0", !isEven && "md:order-1"]}>
    <Badge variant="neutral" class="mb-4">
      <Fragment set:html={iconMap[feature.icon]} />
      {feature.id.replace("-", " ")}
    </Badge>
    <h3 class="font-display text-2xl font-bold tracking-tight text-bone sm:text-3xl">
      {feature.title}
    </h3>
    <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
      {feature.description}
    </p>
    {feature.href && (
      <Button href={feature.href} variant="ghost" size="sm" class="mt-6">
        Learn more
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
        </svg>
      </Button>
    )}
  </div>
</article>
