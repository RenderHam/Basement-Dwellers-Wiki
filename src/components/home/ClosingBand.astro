---
import Badge from "../ui/Badge.astro";
import { SITE } from "../../data/site";
---

<section class="border-t border-line bg-surface/40">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-6 px-4 py-10 sm:flex-row sm:items-center sm:px-6"
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
      <Badge variant="moss">
        <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>
        Server online
      </Badge>
      <p class="text-sm text-muted">
        Modded survival, live world map, friendly community — join the dwellers.
      </p>
    </div>
    <a
      href={SITE.discordUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium text-muted transition-colors duration-200 hover:text-bone"
    >
      Join the Discord
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7"></path>
        <path d="M8 7h9v9"></path>
      </svg>
    </a>
  </div>
</section>
