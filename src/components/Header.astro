---
import { NAV_LINKS, SITE } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
  <nav
    class="relative mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <svg
        class="text-accent size-7"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 2v2"></path>
        <path d="m9 6.5 1-2.5h4l1 2.5"></path>
        <rect x="7.5" y="6.5" width="9" height="11" rx="2.5"></rect>
        <path d="M9 20.5h6"></path>
        <circle cx="12" cy="12" r="1.75" fill="currentColor" stroke="none"></circle>
      </svg>
      <span class="font-display text-lg font-bold tracking-tight text-bone">
        {SITE.name}
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm transition-colors duration-200",
                isActive(link.href)
                  ? "text-accent underline decoration-accent/70 decoration-2 underline-offset-8"
                  : "text-muted hover:text-bone",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="group relative md:hidden">
      <summary
        class="hover:bg-raised flex size-10 cursor-pointer list-none items-center justify-center rounded-md text-bone transition-colors [&::-webkit-details-marker]:hidden"
        aria-label="Toggle navigation menu"
      >
        <svg
          class="group-open:hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="group-open:block hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </summary>
      <div
        class="absolute top-[calc(100%+0.75rem)] right-0 w-56 rounded-xl border border-line bg-surface p-2 shadow-2xl shadow-black/50"
      >
        <ul class="flex flex-col">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "block rounded-lg px-3 py-2.5 text-sm transition-colors",
                    isActive(link.href)
                      ? "bg-raised text-accent"
                      : "text-muted hover:bg-raised hover:text-bone",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </details>
  </nav>
</header>
